<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% if title %}{{ title }} — {% endif %}{{ site.title }}</title>
  {% if description %}<meta name="description" content="{{ description }}" />{% endif %}
  <link rel="stylesheet" href="/style.css" />
  <style>
    .blog-wrap { max-width: 42rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
    .blog-nav { margin-bottom: 2rem; font-size: 0.9rem; }
    .blog-nav a { color: inherit; margin-right: 1rem; }
    .blog-post h1 { font-size: 1.75rem; margin-bottom: 1rem; }
    .blog-post p { line-height: 1.6; margin: 0 0 1rem; }
  </style>
</head>
<body>
  <div class="blog-wrap">
    <nav class="blog-nav mono">
      <a href="/">Home</a>
      <a href="/blog/">Blog</a>
      <a href="/blog/feed.xml">RSS</a>
      <a href="/blog/posts.json">JSON</a>
    </nav>
    {{ content | safe }}
  </div>
</body>
</html>
